function calcLlegar() {
  const bsObj = gv('ll-bs');
  const el = document.getElementById('out-llegar');
  if (!bsObj || bsObj <= 0) { el.innerHTML = empty('🎯','Ingresa los bolívares que quieres obtener.'); return; }

  // ── RUTA A: Zinli + Binance ─────────────────────────────────────────────
  // Always calculate Route A (requires bin + usdt)
  let routeA = null;
  if (R.bin && R.usdt) {
    const saldoBin = bsObj / R.bin;         // USDT needed
    const recargaA = saldoBin * R.usdt;     // Zinli recarga needed
    routeA = fromRecargaZinli(recargaA);
    if (routeA) routeA._targetBs = bsObj;
  }

  // ── RUTA B: Tarjeta directa BCV ─────────────────────────────────────────
  // No Zinli, no USDT. Facebank charges directly at BCV rate.
  let routeB = null;
  if (R.bcv) {
    routeB = { cobro: bsObj / R.bcv, bs: bsObj, rate: R.bcv, label:'BCV' };
  }

  // ── RUTA C: Otra tasa directa ────────────────────────────────────────────
  let routeC = null;
  if (R.alt) {
    routeC = { cobro: bsObj / R.alt, bs: bsObj, rate: R.alt, label:'Otra tasa' };
  }

  // Primary route depends on llRate selection
  const primaryR = llRate === 'bin' ? routeA : (llRate === 'bcv' ? routeB : routeC);
  if (!primaryR) {
    el.innerHTML = empty('🎯', `Ingresa la ${llRate === 'bin' ? 'Tasa Binance y USDT' : llRate === 'bcv' ? 'Tasa BCV' : 'Otra tasa'} para calcular.`);
    return;
  }

  // Compare all three routes by cost (cobro Facebank for Ruta A; cobro directo for B/C)
  const allRoutes = [
    routeA ? { key:'bin', label:'Zinli + Binance', cobro: routeA.cobro } : null,
    routeB ? { key:'bcv', label:'Tarjeta BCV',     cobro: routeB.cobro } : null,
    routeC ? { key:'alt', label:`Tarjeta ${routeC.label}`, cobro: routeC.cobro } : null,
  ].filter(Boolean);

  const cheapest = allRoutes.length ? allRoutes.reduce((a,b) => a.cobro < b.cobro ? a : b) : null;

  // ── BUILD OUTPUT ─────────────────────────────────────────────────────────
  summ['llegar'] = `Monitor v3 — Quiero Bs ${f(bsObj)} a tasa ${llRate.toUpperCase()}\n`
    + (routeA ? `Zinli+Binance: FB cobra $${f(routeA.cobro)}\n` : '')
    + (routeB ? `Tarjeta BCV: FB cobra $${f(routeB.cobro)}\n` : '')
    + (routeC ? `Tarjeta Alt: FB cobra $${f(routeC.cobro)}\n` : '')
    + (cheapest ? `Más barato: ${cheapest.label}` : '');

  function node(cls, icon, title, sub) {
    return `<div class="fnode ${cls}">${icon}</div>
    <div class="fi"><div class="fl">${title}</div>${sub}</div>`;
  }

  function buildRouteACard() {
    if (!routeA) return `<div class="rc-body"><div style="background:var(--am5);border:1px dashed var(--amb);border-radius:var(--r2);padding:.55rem .75rem;font-size:.75rem;color:var(--am7)">⚠ Ingresa <strong>Tasa venta Binance</strong> y <strong>Tasa USDT</strong> para calcular esta ruta.</div></div>`;
    const r = routeA;
    const isWin = cheapest?.key === 'bin';
    const diff  = routeB ? routeB.cobro - r.cobro : null;
    return `<div class="rc-body">
      ${isWin ? '<div class="wtag">✓ Más conveniente</div>' : '<div class="ctag">Opción disponible</div>'}
      <div class="fs">${node('fn-s','↓','Facebank debita de tu cuenta',`<div class="fv big blue">$${f(r.cobro)}</div><div class="fnote">Cobro total incluyendo todas las comisiones</div>`)}</div>
      <div class="fs">${node('fn-f','−','Facebank descuenta (2.80%)',`<div class="fv amber">− $${f(r.fbFee)}</div><div class="fnote fee">${f(r.subtotal, 2)} × 2.80%</div>`)}</div>
      <div class="fs">${node('fn-z','−','Zinli descuenta (3.75%)',`<div class="fv purple">− $${f(r.zinliFee)}</div><div class="fnote fee">${f(r.recarga,2)} × 3.75%</div>`)}</div>
      <div class="fs">${node('fn-z','$','Recarga en tu billetera Zinli',`<div class="fv">$${f(r.recarga)}</div><div class="fnote">Con esto compras USDT</div>`)}</div>
      <div class="fs">${node('fn-b','₿',`Compras USDT a $${f(R.usdt,3)}/USDT`,`<div class="fv amber">${f(r.saldoBin,3)} USDT</div><div class="fnote">$${f(r.recarga)} ÷ $${f(R.usdt,3)}</div>`)}</div>
      <div class="fs">${node('fn-e','Bs',`Vendes en Binance a ${f(R.bin,2)} Bs/USDT`,`<div class="fv big green">Bs ${f(bsObj)}</div><div class="fnote">${f(r.saldoBin,3)} USDT × ${f(R.bin,2)}</div>`)}</div>
      <div class="rr ${isWin?'win':''}">
        ${isWin?'<div class="wtag">✓ Conviene más</div>':''}
        <div class="rrl ${isWin?'green':''}">Obtienes</div>
        <div class="rra ${isWin?'green':''}">Bs ${f(bsObj)}</div>
        <div class="rrc">Facebank cobra: <span>$${f(r.cobro)}</span></div>
        ${diff!==null?`<div class="rrd ${diff>0.001?'win':'neutral'}">${diff>0.001?`Ahorras $${f(diff)} vs tarjeta BCV`:diff<-0.001?`Cuesta $${f(-diff)} más que la tarjeta`:'Mismo costo que BCV'}</div>`:''}
      </div>
    </div>`;
  }

  function buildRouteBCard() {
    if (!routeB) return `<div class="rc-body"><div style="background:var(--am5);border:1px dashed var(--amb);border-radius:var(--r2);padding:.55rem .75rem;font-size:.75rem;color:var(--am7)">⚠ Ingresa la <strong>Tasa BCV</strong> para calcular esta ruta.</div></div>`;
    const r = routeB;
    const isWin = cheapest?.key === 'bcv';
    const diff  = routeA ? routeA.cobro - r.cobro : null;
    return `<div class="rc-body">
      ${isWin ? '<div class="wtag">✓ Más conveniente</div>' : '<div class="ctag">Opción disponible</div>'}
      <div class="fs">${node('fn-g','↓','Facebank debita de tu cuenta',`<div class="fv big gray">$${f(r.cobro)}</div><div class="fnote">Pago directo con tarjeta Facebank</div>`)}</div>
      <div class="fs">${node('fn-g','↓','Sin comisión Zinli',`<div class="fv gray">$0.00 extra</div><div class="fnote">El pago con tarjeta no pasa por Zinli</div>`)}</div>
      <div class="fs">${node('fn-g','↓','Sin conversión a USDT',`<div class="fv gray">No aplica</div><div class="fnote">La tarjeta convierte directo a BCV</div>`)}</div>
      <div class="fs">${node('fn-g','↓','Banco aplica tasa BCV',`<div class="fv gray">${f(R.bcv,2)} Bs/USD</div><div class="fnote">Tasa oficial BCV del día</div>`)}</div>
      <div class="fs">${node(isWin?'fn-e':'fn-g','Bs',`Bolívares que recibes`,`<div class="fv big ${isWin?'green':'gray'}">Bs ${f(bsObj)}</div><div class="fnote">$${f(r.cobro)} × ${f(R.bcv,2)}</div>`)}</div>
      <div class="rr ${isWin?'win':'loser'}">
        ${isWin?'<div class="wtag">✓ Conviene más</div>':''}
        <div class="rrl ${isWin?'green':''}">Obtienes</div>
        <div class="rra ${isWin?'green':'gray'}">Bs ${f(bsObj)}</div>
        <div class="rrc">Facebank cobra: <span>$${f(r.cobro)}</span></div>
        ${diff!==null?`<div class="rrd ${diff>0.001?'win':'neutral'}">${diff>0.001?`Ahorras $${f(diff)} vs Zinli+Binance`:diff<-0.001?`Cuesta $${f(-diff)} más que Zinli`:'Mismo costo'}</div>`:''}
      </div>
    </div>`;
  }

  // Verdict
  let verdictTxt = '';
  if (routeA && routeB) {
    const diffAB = routeB.cobro - routeA.cobro;
    const pct = routeB.cobro > 0 ? Math.abs(diffAB / routeB.cobro) * 100 : 0;
    if (diffAB > 0.01) {
      verdictTxt = `Usando <strong>Zinli + Binance</strong>, Facebank te cobra <span class="hb">$${f(routeA.cobro)}</span> para obtener <span class="hg">Bs ${f(bsObj)}</span>. Con tarjeta directa (BCV) cobraría <span class="ha">$${f(routeB.cobro)}</span>. <strong>Ahorras $${f(diffAB)} (${f(pct,1)}%) usando Zinli+Binance.</strong> ✅`;
    } else if (diffAB < -0.01) {
      const d = Math.abs(diffAB);
      verdictTxt = `Con <strong>tarjeta directa (BCV)</strong>, Facebank cobra <span class="hg">$${f(routeB.cobro)}</span> para obtener <span class="hg">Bs ${f(bsObj)}</span>. Con Zinli+Binance cobraría <span class="ha">$${f(routeA.cobro)}</span>. <strong>Ahorras $${f(d)} (${f(pct,1)}%) pagando con tarjeta.</strong> 💳`;
    } else {
      verdictTxt = `Ambas rutas tienen prácticamente el mismo costo para llegar a <strong>Bs ${f(bsObj)}</strong>.`;
    }
  }

  el.innerHTML = `
    <div style="background:linear-gradient(135deg,var(--b50),var(--teal5));border:1px solid var(--b200);border-radius:var(--r4);padding:1rem 1.2rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.65rem;margin-bottom:.9rem">
      <div>
        <div style="font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--b700);margin-bottom:.18rem">Quiero obtener</div>
        <div style="font-family:var(--m);font-size:1.9rem;font-weight:700;color:var(--b900);line-height:1">Bs ${f(bsObj,0)}</div>
        <div style="font-size:.72rem;color:var(--g500);margin-top:.2rem">Seleccionando tasa: <strong>${llRate === 'bin' ? 'Binance' : llRate === 'bcv' ? 'BCV' : 'Otra tasa'}</strong> · La app compara cuánto cobra Facebank por cada ruta</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.3rem">
        ${cheapest ? `<span class="badge ex"><span class="d"></span>${cheapest.label} es más barata</span>` : ''}
        <button class="bsm" id="cb-llegar" onclick="copySum('llegar')">📋 Copiar</button>
      </div>
    </div>
    <div class="dual-grid">
      <div class="rc">
        <div class="rc-head blue">
          <span class="rch-icon">🔵</span>
          <div><div class="rch-title">Ruta A — Zinli + Binance</div><div class="rch-sub">FB (2.80%) → Zinli (3.75%) → USDT → Binance P2P → Bs</div></div>
        </div>
        ${buildRouteACard()}
      </div>
      <div class="rc">
        <div class="rc-head dark">
          <span class="rch-icon">💳</span>
          <div><div class="rch-title">Ruta B — Tarjeta directa BCV</div><div class="rch-sub">Pagas con tarjeta → Banco aplica tasa BCV → Bs</div></div>
        </div>
        ${buildRouteBCard()}
      </div>
    </div>
    ${verdictTxt ? `<div class="verdict"><div class="vt">💡 Veredicto</div><div class="vb">${verdictTxt}</div></div>` : ''}
    ${routeC ? `<div class="card" style="margin-top:.75rem"><div class="ch">Otra tasa — cobro directo Facebank</div><div class="g2"><div class="mc"><div class="ml">Facebank cobraría</div><div class="mv lg">$${f(routeC.cobro)}</div><div class="ms">Bs ${f(bsObj)} ÷ ${f(R.alt,2)}</div></div><div class="mc"><div class="ml">Diferencia vs Zinli+Binance</div><div class="mv ${routeA&&routeA.cobro<routeC.cobro?'green':'red'}">${routeA?`$${f(Math.abs(routeC.cobro-routeA.cobro))} ${routeA.cobro<routeC.cobro?'más barata (Zinli)':'más cara (Zinli)'}` : '—'}</div></div></div></div>` : ''}`;
}

