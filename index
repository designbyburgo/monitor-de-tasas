let compBaseK = 'bin';
function setCompBase(key, btn) {
  compBaseK = key;
  document.querySelectorAll('#comp-base-pills .bpill').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  calcComp();
}
function calcComp() {
  const ref = gv('comp-ref');
  const el = document.getElementById('out-comp');
  const rates = [];
  if (R.bin)  rates.push({ k:'bin', n:'Tasa venta Binance', v:R.bin });
  if (R.bcv)  rates.push({ k:'bcv', n:'Tasa BCV',           v:R.bcv });
  if (R.alt)  rates.push({ k:'alt', n:'Otra tasa',          v:R.alt });
  if (!rates.length) { el.innerHTML = empty('📊','Completa las tasas del día para ver la comparación.'); return; }

  let bv = null;
  if (compBaseK === 'bin') bv = R.bin;
  else if (compBaseK === 'bcv') bv = R.bcv;
  else bv = R.alt;
  if (!bv) bv = rates[0].v;

  const best  = rates.reduce((a,b) => a.v > b.v ? a : b);
  const worst = rates.reduce((a,b) => a.v < b.v ? a : b);

  let th = `<tr><th>Tasa</th><th>Valor (Bs)</th><th>Dif. absoluta</th><th>Dif. %</th>`;
  if (ref) th += `<th>En Bs (ref.)</th><th>Dif. monetaria</th>`;
  th += `</tr>`;
  let tb = '';
  rates.forEach(r => {
    const isB = r.v === bv;
    const dA  = r.v - bv, dP = bv > 0 ? (r.v-bv)/bv*100 : 0;
    const imp = ref ? r.v*ref : null;
    const iD  = ref && bv ? dA*ref : null;
    const dAs = isB ? `<span class="neut">base</span>` : `<span class="${dA>0?'pos':'neg'}">${dA>0?'+':''}${f(dA,4)}</span>`;
    const dPs = isB ? '' : `<span class="${dP>0?'pos':'neg'}">${dP>0?'+':''}${f(dP,2)}%</span>`;
    const iCs = ref ? `<td>${f(imp,2)}</td><td>${isB?`<span class="neut">—</span>`:`<span class="${(iD||0)>0?'pos':'neg'}">${(iD||0)>0?'+':''}${f(iD,2)}</span>`}</td>` : '';
    tb += `<tr class="${isB?'base':''}"><td>${r.n}${isB?' ⭐':''}</td><td>${f(r.v,4)}</td><td>${dAs}</td><td>${dPs}</td>${iCs}</tr>`;
  });

  const spread = best.v - worst.v, sp2 = worst.v > 0 ? (spread/worst.v)*100 : 0;
  const ins = rates.length >= 2 ? `<div class="reco blue" style="margin-top:.75rem">
    <div style="font-size:.77rem;font-weight:600;margin-bottom:.3rem">Resumen</div>
    <div style="font-size:.77rem;line-height:1.6">
      📈 La tasa más alta es <strong>${best.n}</strong> con <strong>${f(best.v,4)} Bs</strong>.<br>
      📉 Diferencia entre mayor y menor: <strong>${f(spread,4)} Bs</strong> (${f(sp2,2)}%).
      ${ref ? `<br>💰 Para <strong>$${f(ref)}</strong> eso representa <strong>Bs ${f(spread*ref,2)}</strong> adicionales.` : ''}
    </div></div>` : '';

  el.innerHTML = `<div class="card"><div style="overflow-x:auto"><table class="ctbl"><thead>${th}</thead><tbody>${tb}</tbody></table></div>${ins}</div>`;
}

