    ...(usdBCV !==null ? [{ lbl:`Esos Bs en USD a tasa BCV (${f(R.bcv,2)} Bs/USD)`, val:`$${f(usdBCV)} USD`, note:`Bs ${f(bsBin)} ÷ ${f(R.bcv,2)}` }] : []),
    ...(usdAlt !==null ? [{ lbl:`Esos Bs en USD a Otra tasa (${f(R.alt,2)} Bs/USD)`, val:`$${f(usdAlt)} USD`, note:`Bs ${f(bsBin)} ÷ ${f(R.alt,2)}` }] : []),
    ...(r ? [{ lbl:'Cobro Facebank equivalente', val:`$${f(r.cobro)}`, note:`Recarga Zinli $${f(r.recarga)} + fees $${f(r.zinliFee+r.fbFee)}` }] : []),
  ];

  el.innerHTML = `<div class="card">${cpbtn('bin')}
    <div class="g3" style="margin-bottom:.65rem">
      <div class="mc green">
        <div class="ml">Bs que recibirás (Binance)</div>
        <div class="mv xl green">Bs ${f(bsBin)}</div>
        <div class="ms">${f(saldo,3)} USDT × ${f(R.bin,2)} Bs/USDT</div>
      </div>
      <div class="mc">
        <div class="ml">Equiv. en USD a tasa BCV</div>
        <div class="mv xl">$${f(usdBCV)}</div>
        <div class="ms">${R.bcv?`Bs ${f(bsBin)} ÷ ${f(R.bcv,2)}`:'Ingresa tasa BCV'}</div>
