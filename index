function calcFlujo() {
  const v   = gv('flujo-v');
  const wrap = document.getElementById('flujo-flow-wrap');
  const emp  = document.getElementById('flujo-empty');

  if (!v) { wrap.style.display='none'; emp.style.display=''; return; }

  let r = null;
  if      (flujoEntry === 'fb')    r = fromCobroFacebank(v);
  else if (flujoEntry === 'zinli') r = fromRecargaZinli(v);
  else if (flujoEntry === 'bin')   r = fromSaldoBinance(v);
  else if (flujoEntry === 'ubcv')  r = fromUSDatBCV(v);
  else if (flujoEntry === 'ualt')  r = fromUSDatAlt(v);

  if (!r) { wrap.style.display='none'; emp.style.display=''; return; }

  wrap.style.display=''; emp.style.display='none';

  document.getElementById('flujo-flow').innerHTML = buildFlowDiagram(r, flujoEntry);
  document.getElementById('flujo-metrics').innerHTML = buildMetrics(r);

  const rc = recoOf(r.gp);
  document.getElementById('flujo-reco').innerHTML = rc
    ? `<div class="reco ${rc[0]}">💡 ${rc[1]}</div>` : '';

  const scenCard = document.getElementById('flujo-scen-card');
  if (r.tm) {
    scenCard.style.display = '';
    document.getElementById('flujo-scen').innerHTML = buildScenarios(r, 'flujo');
  } else { scenCard.style.display = 'none'; }
}

