<script>
// ══════════════════════════════════════════════════════
//   CONSTANTS
// ══════════════════════════════════════════════════════
const ZP      = 3.75;    // Zinli fee %
const ZF      = 1.0375;  // Zinli factor (1 + 3.75/100)
const FBP     = 2.80;    // Facebank fee %
const FBF     = 1.028;   // Facebank factor (1 + 2.80/100)
const BIN_FEE = 0.08;    // Binance fixed network fee (USDT) — deducted from USDT received
// Total factor: ZF × FBF = 1.0375 × 1.028 = 1.066550

// ══════════════════════════════════════════════════════
//   STATE
// ══════════════════════════════════════════════════════
let currentTab   = 'flujo';
let flujoEntry   = 'fb';   // 'fb' | 'zinli' | 'bin'
let llRate       = 'bin';  // 'bin' | 'bcv' | 'alt'
let compBaseKey  = 'bin';
let summ         = {};

// ══════════════════════════════════════════════════════
//   RATE GETTERS
// ══════════════════════════════════════════════════════
const gv  = id => { const v = parseFloat(document.getElementById(id)?.value); return isNaN(v) ? null : v; };
const R   = {
  get usdt() { return gv('r-usdt'); },
  get bin()  { return gv('r-bin');  },
  get bcv()  { return gv('r-bcv');  },
  get alt()  { return gv('r-alt');  }
};

// ══════════════════════════════════════════════════════
//   CORE MATH — all formulas verified
// ══════════════════════════════════════════════════════

/**
 * Forward from recarga Zinli (USD you want in your Zinli wallet)
 *
 * recargaZinli  → the USD you want credited in Zinli
 * subtotal      = recargaZinli × 1.0375   (Facebank processes this amount)
 * cobro         = subtotal    × 1.028     (total Facebank charges you)
 * zbFee         = cobro - subtotal        (Facebank's 2.80% cut)
 * zinliFee      = subtotal - recargaZinli (Zinli's 3.75% cut)
 * saldoBin      = recargaZinli / tasaUSDT (USDT you receive in Binance)
 */
function fromRecargaZinli(recarga) {
  if (!recarga || recarga <= 0) return null;
  const subtotal  = recarga * ZF;
  const zinliFee  = subtotal - recarga;   // = recarga * 0.0375
  const cobro     = subtotal * FBF;
  const fbFee     = cobro - subtotal;     // = subtotal * 0.028
  const usdt      = R.usdt;
  // USDT: bruto = recarga / tasaUSDT, neto = bruto − BIN_FEE (Binance fixed fee)
  const saldoBinBruto = usdt ? recarga / usdt : null;
  const saldoBin      = saldoBinBruto !== null ? saldoBinBruto - BIN_FEE : null; // NET USDT for selling
  // Always sell at Binance rate → bsBin is the ONLY Bs output
  const bsBin     = (saldoBin !== null && saldoBin > 0 && R.bin) ? saldoBin * R.bin : null;
  // USD equivalents of bsBin at other rates (how much are those Bs worth in USD?)
  const usdBCV    = (bsBin && R.bcv) ? bsBin / R.bcv : null;
  const usdAlt    = (bsBin && R.alt) ? bsBin / R.alt : null;
  // Gain vs BCV: USD equivalent of Bs received vs recarga spent
  const gb  = (usdBCV !== null) ? usdBCV - recarga : null;
  const gp  = (gb !== null && recarga > 0) ? gb / recarga : null;
  const tm  = (saldoBin && recarga && R.bcv) ? (recarga * R.bcv) / saldoBin : null;
  const mg  = (tm && R.bin) ? (R.bin - tm) / tm : null;
  return { recarga, subtotal, zinliFee, cobro, fbFee, saldoBinBruto, saldoBin, bsBin, usdBCV, usdAlt, gb, gp, tm, mg };
}

/**
 * Inverse from cobro Facebank → recarga Zinli and rest of chain
 * cobro = recarga × ZF × FBF
 * → subtotal = cobro / FBF
 * → recarga  = subtotal / ZF
 */
function fromCobroFacebank(cobro) {
  if (!cobro || cobro <= 0) return null;
  const subtotal = cobro / FBF;
  const recarga  = subtotal / ZF;
  return fromRecargaZinli(recarga);
}

/**
 * Inverse from NET saldo Binance (USDT you want to sell) → recarga Zinli → Facebank cobro
 * saldoNeto = USDT you actually sell in Binance P2P
 * saldoBruto = saldoNeto + BIN_FEE  (you need to receive this much before Binance deducts fee)
 * recarga = saldoBruto × tasaUSDT
 */
function fromSaldoBinance(saldoNeto) {
  if (!saldoNeto || saldoNeto <= 0 || !R.usdt) return null;
  const saldoBruto = saldoNeto + BIN_FEE;   // USDT needed before Binance fee
  const recarga    = saldoBruto * R.usdt;    // USD needed in Zinli wallet
  return fromRecargaZinli(recarga);
}

/**
 * Inverse from target USD equivalent at BCV rate
 * "I want the final result to be worth $X at BCV rate"
 * Steps: Bs = usd × bcv → USDT = Bs / bin → recarga = USDT × usdt → cobro = recarga × ZF × FBF
 */
function fromUSDatBCV(usd) {
  if (!usd || usd <= 0 || !R.bcv || !R.bin || !R.usdt) return null;
  const bsTarget = usd * R.bcv;           // Bs needed
  const saldoBin = bsTarget / R.bin;      // USDT to sell
  const recarga  = saldoBin * R.usdt;     // Zinli recarga needed
  const r = fromRecargaZinli(recarga);
  if (!r) return null;
  return { ...r, _usdTarget: usd, _bsTarget: bsTarget, _rateLabel: 'BCV', _rate: R.bcv };
}

/**
 * Inverse from target USD equivalent at Alt rate
 */
function fromUSDatAlt(usd) {
  if (!usd || usd <= 0 || !R.alt || !R.bin || !R.usdt) return null;
  const bsTarget = usd * R.alt;
  const saldoBin = bsTarget / R.bin;
  const recarga  = saldoBin * R.usdt;
  const r = fromRecargaZinli(recarga);
  if (!r) return null;
  return { ...r, _usdTarget: usd, _bsTarget: bsTarget, _rateLabel: 'Otra tasa', _rate: R.alt };
}

/**
 * Inverse from target Bs → how much Facebank charges depends on which rate
 * - Binance: USDT = Bs / tasaBin  → recarga = USDT × tasaUSDT
 * - BCV:     recarga = Bs / tasaBCV  (direct card, no Zinli involved — separate calc)
 * - Alt:     recarga = Bs / tasaAlt  (same as BCV — direct card)
 */
function fromTargetBs(bs, rateKey) {
  if (!bs || bs <= 0) return null;
  if (rateKey === 'bin') {
    if (!R.bin || !R.usdt) return null;
    const saldoBin = bs / R.bin;
    return fromSaldoBinance(saldoBin);
  }
  if (rateKey === 'bcv') {
    if (!R.bcv) return null;
    // Direct card payment — no Zinli, no USDT
    const cobroDirecto = bs / R.bcv;
    return { __direct: true, rate: R.bcv, rateName: 'BCV', cobro: cobroDirecto, bs };
  }
  if (rateKey === 'alt') {
    if (!R.alt) return null;
    const cobroDirecto = bs / R.alt;
    return { __direct: true, rate: R.alt, rateName: 'Otra tasa', cobro: cobroDirecto, bs };
  }
  return null;
}

// ══════════════════════════════════════════════════════
//   HELPERS
// ══════════════════════════════════════════════════════
function f(v, d=2) {
  if (v === null || v === undefined || isNaN(v)) return '—';
  return v.toLocaleString('es-VE', { minimumFractionDigits: d, maximumFractionDigits: d });
}
function fp(v) {
  if (v === null || v === undefined || isNaN(v)) return '—';
  return (v >= 0 ? '+' : '') + f(v * 100, 2) + '%';
}
function empty(icon, msg) {
  return `<div class="card"><div class="emp"><div class="ei">${icon}</div><p>${msg}</p></div></div>`;
}
function statusOf(gp) {
  if (gp === null) return null;
  const p = gp * 100;
  if (p >= 6)  return { l:'Excelente oportunidad', c:'ex' };
  if (p >= 2)  return { l:'Buena oportunidad',     c:'gd' };
  if (p >= 0)  return { l:'Margen débil',           c:'wk' };
  return { l:'No conviene por Binance', c:'bd' };
}
function recoOf(gp) {
  if (gp === null) return null;
  const p = gp * 100;
  if (p >= 6)  return ['green','<strong>Excelente momento.</strong> Binance ofrece una salida claramente mejor que BCV.'];
  if (p >= 2)  return ['green','<strong>Buena oportunidad.</strong> La ruta Zinli+Binance es rentable.'];
  if (p >= 0)  return ['amber','<strong>Margen débil.</strong> Apenas cubre los costos. Evalúa si vale la pena.'];
  return ['red','<strong>No conviene.</strong> La tarjeta directa a BCV daría más bolívares que Binance.'];
}
function cpbtn(key) {
  return `<div style="display:flex;justify-content:flex-end;margin-bottom:.6rem"><button class="bsm" id="cb-${key}" onclick="copySum('${key}')">📋 Copiar resumen</button></div>`;
}
function copySum(key) {
  const t = summ[key]; if (!t) return;
  navigator.clipboard.writeText(t).then(() => {
    const b = document.getElementById('cb-'+key); if (!b) return;
    const o = b.innerHTML; b.innerHTML = '✅ Copiado'; b.classList.add('ok');
    setTimeout(() => { b.innerHTML = o; b.classList.remove('ok'); }, 2000);
  });
}

