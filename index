function setEntry(mode) {
  flujoEntry = mode;
  ['fb','zinli','bin','ubcv','ualt'].forEach(k => {
    const btn = document.getElementById('ep-'+k);
    if (!btn) return;
    // Reset to base class
    btn.className = `ep ${k}`;
    btn.style.background = '';
    btn.style.borderColor = k==='ubcv' ? 'var(--ok6)' : k==='ualt' ? 'var(--g400)' : '';
    btn.style.color = k==='ubcv' ? 'var(--ok7)' : k==='ualt' ? 'var(--g600)' : '';
    if (k === mode) {
      btn.className = `ep ${k} active`;
      btn.style.background = '';
      btn.style.borderColor = '';
      btn.style.color = '';
    }
  });
  document.getElementById('flujo-hint').textContent = ENTRY_HINTS[mode] || '';
  document.getElementById('flujo-v').value = '';
  const placeholders = { fb:'106.66', zinli:'100.00', bin:'98.039', ubcv:'100.00', ualt:'100.00' };
