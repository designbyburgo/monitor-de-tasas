  d['_tab']     = currentTab;
  d['_entry']   = flujoEntry;
  d['_llrate']  = llRate;
  d['_compbase']= compBaseK;
  localStorage.setItem('mdt_v3', JSON.stringify(d));
  flash('btn-save','✅ Guardado');
}
function loadAll() {
  try {
    const raw = localStorage.getItem('mdt_v3');
    if (!raw) { flash('btn-load','⚠ Sin datos'); return; }
    const d = JSON.parse(raw);
    [...RATE_IDS, ...AMOUNT_IDS].forEach(id => { const el = document.getElementById(id); if(el && d[id]!==undefined) el.value = d[id]; });
    if (d._entry) { flujoEntry = d._entry; setEntry(d._entry); }
    recalcActive();
    flash('btn-load','✅ Cargado');
  } catch(e) { console.error(e); }
}
function resetRates() {
  RATE_IDS.forEach(id => { const el = document.getElementById(id); if(el) el.value = ''; });
  recalcActive();
}
function flash(id, msg) {
  const b = document.getElementById(id); if (!b) return;
  const o = b.textContent; b.textContent = msg; b.classList.add('ok');
  setTimeout(() => { b.textContent = o; b.classList.remove('ok'); }, 1800);
}

