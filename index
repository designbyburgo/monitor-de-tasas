// ══════════════════════════════════════════════════════
//   SCENARIOS
// ══════════════════════════════════════════════════════
function buildScenarios(r, mode) {
  if (!r || !r.tm) return '';
  const base = r.tm;
  const offs = [
    { p:-3, l:'Conservadora' }, { p:0, l:'Equilibrio' },
    { p:3,  l:'Media' },        { p:7, l:'Alta' }, { p:12, l:'Muy alta' }
  ];
  let h = '<div class="schips">';
  offs.forEach(o => {
    const rate  = base * (1 + o.p / 100);
    const bs    = r.saldoBin ? r.saldoBin * rate : null;
    const gn    = (bs && r.bsBCV) ? (bs - r.bsBCV) / r.bsBCV : 0;
    const gc    = gn >= 0.04 ? 'pos' : gn >= 0 ? '' : 'neg';
    const isAct = R.bin && Math.abs(rate - R.bin) < R.bin * 0.015;
    h += `<button class="schip ${isAct?'active':''}" onclick="applyScen(${rate.toFixed(2)})">
      <div style="font-family:var(--m);font-weight:700;font-size:.77rem">${f(rate,2)}</div>
      <div style="font-size:.63rem;color:${isAct?'rgba(255,255,255,.75)':'var(--g400)'};margin:.04rem 0">${o.l}</div>
      <div class="${gc}" style="font-family:var(--m);font-size:.69rem;font-weight:600">${fp(gn)}</div>
    </button>`;
  });
  return h + '</div>';
}
function applyScen(rate) {
  document.getElementById('r-bin').value = rate.toFixed(2);
  recalcActive();
}

// ══════════════════════════════════════════════════════
//   STEPS BUILDER
// ══════════════════════════════════════════════════════
function buildSteps(steps) {
  let h = '<div class="steps">';
  steps.forEach((s, i) => {
    const last = i === steps.length - 1;
    const nc = s.hi ? 'hi' : s.purple ? 'purple' : s.green ? 'green' : s.amber ? 'amber' : s.gray ? 'gray' : 'blue';
    h += `<div class="step">
      <div style="display:flex;flex-direction:column;align-items:center;flex-shrink:0">
        <div class="snum ${nc}">${i+1}</div>
        ${!last ? '<div class="sconn"></div>' : ''}
      </div>
      <div class="sbody">
        <div class="slbl">${s.lbl}</div>
        <div class="sval ${s.vc||''}">${s.val}</div>
        ${s.note ? `<div class="snote">${s.note}</div>` : ''}
      </div>
    </div>`;
  });
  return h + '</div>';
}

// Full route steps from a result object
function routeSteps(r) {
  const steps = [
    { lbl:'Cobro total en Facebank', val:`$${f(r.cobro)}`, hi:true, note:'Lo que ves debitado en tu cuenta' },
    { lbl:'Facebank descuenta su comisión (2.80%)', val:`− $${f(r.fbFee)}`, vc:'amber', amber:true, note:`$${f(r.subtotal)} × 2.80% — cargo separado en estado de cuenta` },
    { lbl:'Zinli descuenta su comisión (3.75%)', val:`− $${f(r.zinliFee)}`, vc:'purple', purple:true, note:`$${f(r.recarga)} × 3.75% — la recarga que pediste incluye este fee` },
    { lbl:'Recarga acreditada en tu billetera Zinli', val:`$${f(r.recarga)}`, note:'USD disponibles para comprar USDT' },
    { lbl:`Compras USDT a $${f(R.usdt,3)}/USDT — recibes bruto`, val:`${f(r.saldoBinBruto,4)} USDT`, vc:'amber', note:`$${f(r.recarga)} ÷ $${f(R.usdt,3)}` },
    { lbl:'Binance descuenta fee de red (−0.08 USDT)', val:`${f(r.saldoBin,4)} USDT netos`, note:'USDT disponibles para vender en P2P' },
  ];
  if (r.bsBin !== null && r.bsBin !== undefined)
    steps.push({ lbl:`Vendes ${f(r.saldoBin,4)} USDT netos en Binance P2P a ${f(R.bin,2)} Bs/USDT`, val:`Bs ${f(r.bsBin)}`, vc:'green', green:true, note:'Resultado final — estos Bs son lo que recibes' });
  if (r.usdBCV !== null && r.usdBCV !== undefined)
    steps.push({ lbl:`Esos Bs en USD equivalente a tasa BCV (${f(R.bcv,2)} Bs/USD)`, val:`$${f(r.usdBCV)} USD`, note:`Bs ${f(r.bsBin)} ÷ ${f(R.bcv,2)} = $${f(r.usdBCV)}` });
  if (r.usdAlt !== null && r.usdAlt !== undefined)
    steps.push({ lbl:`Esos Bs en USD equivalente a Otra tasa (${f(R.alt,2)} Bs/USD)`, val:`$${f(r.usdAlt)} USD`, note:`Bs ${f(r.bsBin)} ÷ ${f(R.alt,2)} = $${f(r.usdAlt)}` });
  return steps;
}

