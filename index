  // USD equivalents of those Bs at other rates
  const usdBCV = (bsBin && R.bcv) ? bsBin / R.bcv : null;
  const usdAlt = (bsBin && R.alt) ? bsBin / R.alt : null;
  // Reconstruct upstream costs
  const r = fromSaldoBinance(saldo);

  summ['bin'] = `Monitor v3 — Desde Binance\nSaldo: ${f(saldo,3)} USDT\nBs Binance: ${f(bsBin)}\nEquiv USD BCV: $${f(usdBCV)}\nEquiv USD Alt: $${f(usdAlt)}`;

