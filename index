<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Monitor de Tasas v3</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --b900:#0e2340;--b700:#1b4c7a;--b600:#1d61aa;--b500:#2478d0;--b400:#4c9de0;
  --b200:#b9ddf7;--b100:#e2f1fd;--b50:#f0f8ff;
  --pu700:#5b21b6;--pu600:#7c3aed;--pu400:#a78bfa;--pu100:#ede9fe;--pu50:#f5f3ff;
  --teal6:#0d9488;--teal1:#ccfbf1;--teal5:#f0fdfa;
  --g900:#0f172a;--g800:#1e293b;--g700:#334155;--g600:#475569;--g500:#64748b;
  --g400:#94a3b8;--g300:#cbd5e1;--g200:#e2e8f0;--g100:#f1f5f9;--g50:#f8fafc;
  --ok7:#166534;--ok6:#16a34a;--ok1:#dcfce7;--ok5:#f0fdf4;--okb:#86efac;
  --am7:#b45309;--am6:#d97706;--am1:#fef3c7;--am5:#fffbeb;--amb:#fcd34d;
  --rd7:#b91c1c;--rd6:#dc2626;--rd1:#fee2e2;--rd5:#fef2f2;--rdb:#fca5a5;
  --white:#fff;--surf:#f8fafc;--brd:#e2e8f0;
  --sh0:0 1px 2px rgba(14,35,64,.05);
  --sh1:0 1px 4px rgba(14,35,64,.08),0 1px 2px rgba(14,35,64,.04);
  --sh2:0 4px 14px rgba(14,35,64,.10),0 2px 4px rgba(14,35,64,.05);
  --sh3:0 8px 28px rgba(14,35,64,.13),0 3px 8px rgba(14,35,64,.07);
  --r2:6px;--r3:10px;--r4:14px;
  --f:'DM Sans',system-ui,sans-serif;--m:'DM Mono','Courier New',monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:15px;-webkit-font-smoothing:antialiased}
body{font-family:var(--f);background:var(--surf);color:var(--g900);min-height:100vh;line-height:1.55}
input[type=number]::-webkit-inner-spin-button{opacity:.35}

/* ── HEADER ── */
.hdr{background:var(--white);border-bottom:1px solid var(--brd);padding:0 1.5rem;position:sticky;top:0;z-index:300;box-shadow:var(--sh0)}
.hdr-in{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:52px;gap:1rem}
.brand{display:flex;align-items:center;gap:.5rem;text-decoration:none}
.bmark{width:28px;height:28px;border-radius:7px;background:var(--b600);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:#fff;flex-shrink:0}
.bname{font-size:.9rem;font-weight:700;color:var(--b900);letter-spacing:-.02em}
.bv{font-size:.6rem;font-weight:700;background:var(--teal1);color:var(--teal6);padding:.08rem .38rem;border-radius:3px;margin-left:.25rem;letter-spacing:.04em}
.hend{display:flex;align-items:center;gap:.35rem}
.hbtn{background:none;border:1px solid var(--brd);border-radius:var(--r2);padding:.26rem .58rem;cursor:pointer;font-family:var(--f);font-size:.73rem;color:var(--g600);font-weight:500;display:flex;align-items:center;gap:.25rem;transition:all .15s}
.hbtn:hover{background:var(--b50);border-color:var(--b400);color:var(--b700)}
.hbtn.ok{background:var(--ok5);border-color:var(--okb);color:var(--ok6)}

/* ── NAV ── */
.nav{background:var(--white);border-bottom:1px solid var(--brd);overflow-x:auto;scrollbar-width:none}
.nav::-webkit-scrollbar{display:none}
.nav-in{max-width:1100px;margin:0 auto;padding:0 1.5rem;display:flex}
.ntab{padding:.72rem .9rem;border:none;background:none;cursor:pointer;font-family:var(--f);font-size:.79rem;font-weight:500;color:var(--g500);border-bottom:2.5px solid transparent;transition:all .15s;margin-bottom:-1px;white-space:nowrap}
.ntab:hover{color:var(--b600)}
.ntab.active{color:var(--b600);border-bottom-color:var(--b500);font-weight:700}

/* ── WRAP ── */
.wrap{max-width:1100px;margin:0 auto;padding:1.25rem 1.5rem 4rem}

/* ── RATES BAR ── */
.rates-bar{background:var(--white);border:1px solid var(--brd);border-radius:var(--r4);padding:.7rem 1rem;box-shadow:var(--sh1);margin-bottom:1rem;display:flex;align-items:stretch;gap:0;flex-wrap:wrap}
.rb-title{font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--g400);display:flex;align-items:center;padding-right:1rem;border-right:1px solid var(--g100);margin-right:.2rem;white-space:nowrap;align-self:center}
.rb-field{display:flex;flex-direction:column;justify-content:center;padding:.1rem .85rem;border-right:1px solid var(--g100)}
.rb-field:last-of-type{border-right:none}
.rb-label{font-size:.64rem;font-weight:600;color:var(--g500);margin-bottom:.22rem;display:flex;align-items:center;gap:.25rem;white-space:nowrap}
.rb-tag{font-size:.55rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:.05rem .28rem;border-radius:3px}
.tag-fb{background:var(--b100);color:var(--b700)}
.tag-zinli{background:var(--pu100);color:var(--pu700)}
.tag-bin{background:#1a1a2e;color:#f0b90b}
.tag-bcv{background:var(--ok1);color:var(--ok7)}
.tag-alt{background:var(--g100);color:var(--g600)}
.rb-inp{width:88px;padding:.3rem .45rem;border:1px solid var(--g200);border-radius:var(--r2);font-family:var(--m);font-size:.82rem;color:var(--g900);background:transparent;outline:none;transition:border-color .15s,box-shadow .15s}
.rb-inp:focus{border-color:var(--b400);box-shadow:0 0 0 2px rgba(36,120,208,.1);background:var(--white)}
.rb-inp::placeholder{color:var(--g300)}
.rb-unit{font-size:.63rem;color:var(--g400);margin-top:.12rem}
.rb-fees{display:flex;align-items:center;gap:.35rem;margin-left:auto;padding-left:.85rem;flex-shrink:0;align-self:center}
.fee-tag{font-size:.67rem;font-weight:600;padding:.26rem .55rem;border-radius:var(--r2);white-space:nowrap}
.fee-tag.z{background:var(--pu100);color:var(--pu700)}
.fee-tag.f{background:var(--b100);color:var(--b700)}
.fee-tag.t{background:var(--g100);color:var(--g700);font-weight:700}

/* ── PANELS ── */
.panel{display:none}
.panel.active{display:block;animation:fu .18s ease}
@keyframes fu{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}

/* ── CARD ── */
.card{background:var(--white);border:1px solid var(--brd);border-radius:var(--r4);padding:1.1rem 1.2rem;box-shadow:var(--sh1)}
.card+.card{margin-top:.75rem}
.ch{font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--g400);margin-bottom:.85rem;display:flex;align-items:center;gap:.35rem}
.ct{font-size:.88rem;font-weight:700;color:var(--g800);margin-bottom:.25rem;letter-spacing:-.01em}
.cs{font-size:.76rem;color:var(--g500);margin-bottom:.85rem;line-height:1.45}

/* ── FORM ── */
.fg{margin-bottom:.7rem}.fg:last-child{margin-bottom:0}
label{display:flex;align-items:center;gap:.25rem;font-size:.74rem;font-weight:600;color:var(--g700);margin-bottom:.25rem}
input[type=number],input[type=text]{width:100%;padding:.44rem .65rem;border:1px solid var(--g300);border-radius:var(--r2);font-family:var(--m);font-size:.82rem;color:var(--g900);background:var(--white);outline:none;transition:border-color .15s,box-shadow .15s}
input:focus{border-color:var(--b400);box-shadow:0 0 0 3px rgba(36,120,208,.1)}
input::placeholder{color:var(--g300);font-size:.79rem}
.hint{font-size:.65rem;color:var(--g400);margin-top:.15rem;line-height:1.35}
hr.dv{border:none;border-top:1px solid var(--g100);margin:.8rem 0}

/* ── FLUJO COMPLETO ── */
.flujo-amount-wrap{background:linear-gradient(135deg,var(--b50),var(--pu50));border:1px solid var(--b200);border-radius:var(--r4);padding:1.3rem 1.5rem;margin-bottom:1rem}
.flujo-amount-label{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--b700);margin-bottom:.5rem}
.flujo-amount-row{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap}
.flujo-big-inp{flex:1;min-width:180px;padding:.65rem .85rem;border:2px solid var(--b300);border-radius:var(--r3);font-family:var(--m);font-size:1.5rem;font-weight:600;color:var(--g900);background:var(--white);outline:none;transition:border-color .15s,box-shadow .15s}
.flujo-big-inp:focus{border-color:var(--b500);box-shadow:0 0 0 3px rgba(36,120,208,.12)}
.flujo-big-inp::placeholder{color:var(--g300);font-size:1.1rem}
.entry-pills{display:flex;gap:.4rem;flex-wrap:wrap;align-items:center}
.ep{padding:.38rem .85rem;border:1.5px solid var(--brd);border-radius:20px;cursor:pointer;background:none;font-family:var(--f);font-size:.76rem;font-weight:600;color:var(--g600);transition:all .15s;white-space:nowrap}
.ep:hover{background:var(--b50);border-color:var(--b400)}
.ep.active.fb{background:var(--b600);border-color:var(--b600);color:#fff}
.ep.active.zinli{background:var(--pu600);border-color:var(--pu600);color:#fff}
.ep.active.bin{background:#1a1a2e;border-color:#f0b90b;color:#f0b90b}
.ep.active.bs{background:var(--ok6);border-color:var(--ok6);color:#fff}
.ep.active.ubcv{background:var(--ok6);border-color:var(--ok6);color:#fff}
.ep.active.ualt{background:var(--g700);border-color:var(--g700);color:#fff}
.entry-hint{font-size:.72rem;color:var(--g500);margin-top:.55rem;line-height:1.4}

/* ── FLOW DIAGRAM ── */
.flow-diagram{display:flex;align-items:stretch;gap:0;margin:1rem 0;overflow-x:auto}
.fn{flex:0 0 auto;min-width:140px;display:flex;flex-direction:column;border-radius:var(--r3);overflow:hidden;box-shadow:var(--sh1)}
.fn-head{padding:.55rem .75rem;font-size:.66rem;font-weight:700;letter-spacing:.04em;color:#fff;display:flex;align-items:center;gap:.3rem;white-space:nowrap}
.fn-head.fb{background:var(--b600)}
.fn-head.zinli{background:var(--pu600)}
.fn-head.bin{background:#1a1a2e;color:#f0b90b}
.fn-head.bs{background:var(--ok6)}
.fn-body{flex:1;background:var(--white);border:1px solid var(--brd);border-top:none;padding:.7rem .75rem}
.fn-body.active{background:var(--b50);border-color:var(--b400)}
.fn-body.active.zinli-active{background:var(--pu50);border-color:var(--pu400)}
.fn-body.active.bin-active{background:#1a1a2e0a;border-color:#f0b90b55}
.fn-body.active.bs-active{background:var(--ok5);border-color:var(--okb)}
.fn-val{font-family:var(--m);font-size:1.1rem;font-weight:700;color:var(--g900);line-height:1.2;margin-bottom:.1rem}
.fn-val.blue{color:var(--b600)}.fn-val.purple{color:var(--pu600)}.fn-val.gold{color:#b45309}.fn-val.green{color:var(--ok6)}.fn-val.muted{color:var(--g400);font-size:.85rem;font-weight:500}
.fn-sub{font-size:.63rem;color:var(--g400);line-height:1.35;margin-top:.08rem}
.fn-fee{display:inline-flex;align-items:center;margin-top:.3rem;font-size:.62rem;font-weight:700;padding:.15rem .38rem;border-radius:3px}
.fn-fee.z{background:var(--pu100);color:var(--pu700)}
.fn-fee.f{background:var(--b100);color:var(--b700)}
.fn-arrow{display:flex;align-items:center;justify-content:center;padding:0 .35rem;color:var(--g300);font-size:1.1rem;flex-shrink:0;align-self:center;margin-top:.75rem}

/* Bs node — 3 parallel columns */
.fn.bs-node{min-width:300px}
.bs-cols{display:grid;grid-template-columns:1fr 1fr 1fr;gap:0}
.bs-col{padding:.6rem .65rem;border-right:1px solid var(--g100)}
.bs-col:last-child{border-right:none}
.bs-col-label{font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.28rem;display:flex;align-items:center;gap:.2rem}
.bs-col-label.bin{color:#b45309}
.bs-col-label.bcv{color:var(--ok7)}
.bs-col-label.alt{color:var(--g600)}
.bs-val{font-family:var(--m);font-size:.92rem;font-weight:700;color:var(--g900)}
.bs-val.best{color:var(--ok6);font-size:1rem}
.bs-sub{font-size:.6rem;color:var(--g400);margin-top:.06rem}

/* ── METRIC CARDS ── */
.g2{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:.65rem}
.mc{background:var(--white);border:1px solid var(--brd);border-radius:var(--r3);padding:.75rem .9rem;box-shadow:var(--sh0)}
.mc.blue{background:var(--b50);border-color:var(--b200)}
.mc.purple{background:var(--pu50);border-color:var(--pu100)}
.mc.green{background:var(--ok5);border-color:var(--okb)}
.mc.amber{background:var(--am5);border-color:var(--amb)}
.mc.red{background:var(--rd5);border-color:var(--rdb)}
.mc.gray{background:var(--g50);border-color:var(--g200)}
.ml{font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--g500);margin-bottom:.2rem}
.mv{font-family:var(--m);font-size:.95rem;font-weight:600;color:var(--g900);line-height:1.2}
.mv.lg{font-size:1.1rem}.mv.xl{font-size:1.35rem}
.mv.blue{color:var(--b600)}.mv.purple{color:var(--pu600)}.mv.green{color:var(--ok6)}.mv.amber{color:var(--am6)}.mv.red{color:var(--rd6)}
.ms{font-size:.62rem;color:var(--g400);margin-top:.12rem}

/* ── BADGE ── */
.badge{display:inline-flex;align-items:center;gap:.28rem;padding:.22rem .58rem;border-radius:20px;font-size:.7rem;font-weight:700}
.badge .d{width:5px;height:5px;border-radius:50%;background:currentColor}
.badge.ex{background:var(--ok1);color:var(--ok7)}
.badge.gd{background:var(--b100);color:var(--b700)}
.badge.wk{background:var(--am1);color:var(--am7)}
.badge.bd{background:var(--rd1);color:var(--rd7)}

/* ── STEPS ── */
.steps{display:flex;flex-direction:column}
.step{display:flex;align-items:flex-start;gap:.6rem;padding:.52rem 0}
.step:not(:last-child){border-bottom:1px solid var(--g100)}
.snum{width:20px;height:20px;border-radius:50%;font-size:.63rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.snum.hi{background:var(--b600);color:#fff}
.snum.purple{background:var(--pu600);color:#fff}
.snum.green{background:var(--ok1);color:var(--ok7)}
.snum.amber{background:var(--am1);color:var(--am7)}
.snum.gray{background:var(--g100);color:var(--g600)}
.snum.blue{background:var(--b100);color:var(--b700)}
.sconn{width:2px;background:var(--g100);flex:1;min-height:10px;margin-top:3px}
.sbody{flex:1}
.slbl{font-size:.71rem;font-weight:600;color:var(--g600);margin-bottom:.1rem}
.sval{font-family:var(--m);font-size:.88rem;font-weight:500;color:var(--g900)}
.sval.blue{color:var(--b600)}.sval.purple{color:var(--pu600)}.sval.green{color:var(--ok6)}.sval.amber{color:var(--am6)}.sval.red{color:var(--rd6)}
.snote{font-size:.63rem;color:var(--g400);margin-top:.06rem}

/* ── RECO ── */
.reco{border-left:3px solid var(--b500);border-radius:var(--r3);padding:.7rem .9rem;font-size:.79rem;line-height:1.5}
.reco.blue{background:var(--b50);border-color:var(--b500);color:var(--b900)}
.reco.green{background:var(--ok5);border-color:var(--ok6);color:var(--g800)}
.reco.amber{background:var(--am5);border-color:var(--am6);color:var(--g800)}
.reco.red{background:var(--rd5);border-color:var(--rd6);color:var(--g800)}

/* ── SCENARIOS ── */
.schips{display:flex;gap:.38rem;flex-wrap:wrap}
.schip{border:1px solid var(--brd);border-radius:var(--r2);padding:.35rem .65rem;cursor:pointer;background:none;font-family:var(--f);font-size:.7rem;font-weight:500;color:var(--g600);transition:all .15s;text-align:left}
.schip:hover{background:var(--b50);border-color:var(--b400);color:var(--b700)}
.schip.active{background:var(--b600);border-color:var(--b600);color:#fff}

/* ── DUAL ROUTE (Quiero llegar a) ── */
.dual-grid{display:grid;grid-template-columns:1fr 1fr;gap:.9rem;margin-bottom:.9rem}
.rc{border-radius:var(--r4);overflow:hidden;box-shadow:var(--sh2)}
.rc-head{padding:.75rem 1rem;display:flex;align-items:center;gap:.5rem}
.rc-head.blue{background:var(--b600)}
.rc-head.dark{background:var(--g700)}
.rch-icon{font-size:1.1rem}
.rch-title{color:#fff;font-size:.81rem;font-weight:700}
.rch-sub{color:rgba(255,255,255,.6);font-size:.66rem;margin-top:.04rem}
.rc-body{background:var(--white);border:1px solid var(--brd);border-top:none;padding:.8rem}
.fs{position:relative;padding-left:2.1rem;margin-bottom:.05rem}
.fs:not(:last-child)::after{content:'';position:absolute;left:.65rem;top:1.9rem;width:2px;height:calc(100% - .3rem);background:var(--g200)}
.fnode{position:absolute;left:0;top:.1rem;width:1.35rem;height:1.35rem;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;flex-shrink:0;z-index:1}
.fn-s{background:var(--g100);color:var(--g600)}
.fn-z{background:var(--pu100);color:var(--pu700)}
.fn-f{background:var(--b100);color:var(--b700)}
.fn-b{background:#1a1a2e0f;color:#92400e}
.fn-e{background:var(--ok1);color:var(--ok7);width:1.5rem;height:1.5rem}
.fn-g{background:var(--g200);color:var(--g600)}
.fi{padding:.5rem 0 .75rem .1rem}
.fl{font-size:.67rem;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--g500);margin-bottom:.12rem}
.fv{font-family:var(--m);font-size:1rem;font-weight:600;color:var(--g900)}
.fv.big{font-size:1.2rem}
.fv.blue{color:var(--b600)}.fv.purple{color:var(--pu600)}.fv.green{color:var(--ok6)}.fv.amber{color:var(--am6)}.fv.gray{color:var(--g500)}
.fnote{font-size:.64rem;color:var(--g400);margin-top:.08rem;line-height:1.35}
.fnote.fee{color:var(--am7);font-weight:600}
.rr{border-top:2px solid var(--g200);margin-top:.1rem;padding:.75rem;background:var(--g50)}
.rr.win{background:var(--ok5);border-top-color:var(--ok6)}
.rrl{font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--g500);margin-bottom:.18rem}
.rrl.green{color:var(--ok7)}
.rra{font-family:var(--m);font-size:1.3rem;font-weight:700;color:var(--g900)}
.rra.green{color:var(--ok6)}.rra.gray{color:var(--g500)}
.rrc{font-size:.71rem;color:var(--g500);margin-top:.2rem}
.rrc span{font-family:var(--m);font-weight:600;color:var(--g700)}
.rrd{font-size:.72rem;margin-top:.28rem;font-weight:600}
.rrd.win{color:var(--ok6)}.rrd.neutral{color:var(--g500)}
.wtag{display:inline-flex;align-items:center;gap:.22rem;background:var(--ok6);color:#fff;font-size:.62rem;font-weight:700;padding:.15rem .45rem;border-radius:3px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:.3rem}
.ctag{display:inline-flex;align-items:center;gap:.22rem;background:var(--g200);color:var(--g600);font-size:.62rem;font-weight:700;padding:.15rem .45rem;border-radius:3px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:.3rem}
.verdict{background:var(--white);border:1px solid var(--brd);border-radius:var(--r4);padding:.95rem 1.1rem;box-shadow:var(--sh1)}
.vt{font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--g400);margin-bottom:.38rem}
.vb{font-size:.82rem;color:var(--g800);line-height:1.55}
.vb .hb{color:var(--b600);font-weight:700;font-family:var(--m)}
.vb .hg{color:var(--ok6);font-weight:700;font-family:var(--m)}
.vb .ha{color:var(--am6);font-weight:700;font-family:var(--m)}

/* ── COMPARE TABLE ── */
.ctbl{width:100%;border-collapse:collapse;font-size:.79rem}
.ctbl th{text-align:left;padding:.45rem .7rem;font-size:.63rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--g500);background:var(--g50);border-bottom:1px solid var(--brd)}
.ctbl td{padding:.6rem .7rem;border-bottom:1px solid var(--g100);font-family:var(--m)}
.ctbl td:first-child{font-family:var(--f);font-weight:500}
